    {"id": 2, "type": "timeseries", "title": "Request rate", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "sum(rate(http_requests_total{job=\"scoutline-backend\"}[5m]))", "legendFormat": "requests/sec", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "5xx error rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(http_requests_total{job=\"scoutline-backend\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "P95 request latency", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket{job=\"scoutline-backend\"}[5m])) by (le))", "legendFormat": "p95 seconds", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Host memory used", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "used ratio", "refId": "A"}]},
