# Server
CORS_ORIGINS=http://localhost:5173

# Live research integrations (keep these server-side only)
# Left blank intentionally: the app runs without keys. Health check works, and
# searches report a clean "blocked" state instead of fabricating candidates.
# Add real keys here to enable live research.
GROQ_API_KEY=
# Optional: override the Groq model if the default is retired (see console.groq.com/docs/models).
# GROQ_MODEL=openai/gpt-oss-120b
SERPAPI_KEY=
GITHUB_TOKEN=

# --- Database ---
# Default: the bundled PostgreSQL service from docker-compose.yml (hostname "db").
DATABASE_URL=postgresql://postgres:postgres@db:5432/scoutline
#
# Supabase instead: use the Session pooler connection string (port 5432, IPv4) from
# Project Settings -> Database. The direct connection (db.<ref>.supabase.co:5432) is
# IPv6-only and unreachable from Docker. The username is "postgres.<project-ref>".
# URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Apply Alembic migrations automatically on startup.
AUTO_MIGRATE=true
